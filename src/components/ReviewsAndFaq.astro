---
import { business, faqs, reviews } from '../data/site';
---

<section class="section reviews" id="opinie" aria-labelledby="reviews-title">
  <div class="shell">
    <header class="section-heading section-heading--compact" data-reveal="left">
      <span class="section-kicker">
        <span class="section-kicker__index" aria-hidden="true">06</span>
        <span class="section-kicker__label">Opinie</span>
      </span>
      <h2 id="reviews-title">Zaufanie w praktyce</h2>
    </header>

    <div class="reviews__grid" data-reveal-group>
      {reviews.map(([name, text], index) => (
        <article class:list={['review', { 'review--dark': index === 0 }]}> 
          <b aria-hidden="true">“</b>
          <p>{text}</p>
          <footer>
            <i aria-hidden="true">{name.charAt(0)}</i>
            <span><strong>{name}</strong><small>Opinia klienta</small></span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section faq" aria-labelledby="faq-title">
  <div class="shell faq__inner">
    <header class="faq__intro" data-reveal="left">
      <span class="section-kicker">
        <span class="section-kicker__index" aria-hidden="true">07</span>
        <span class="section-kicker__label">FAQ</span>
      </span>
      <h2 id="faq-title">Najważniejsze odpowiedzi</h2>
      <p class="faq__lead">
        Zebraliśmy pytania, które najczęściej pojawiają się przed porównaniem ofert i zmianą ubezpieczenia.
      </p>
      <div class="faq__contact">
        <small>Twojej sytuacji nie ma na liście?</small>
        <a class="faq__phone" href={`tel:${business.primaryTel}`}>{business.primaryPhone}</a>
        <a class="text-link" href="#kontakt">Opisz, czego potrzebujesz <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <div class="faq__list" data-reveal="right">
      {faqs.map(([question, answer], index) => {
        const panelId = `faq-panel-${index + 1}`;
        const buttonId = `faq-button-${index + 1}`;
        const initiallyOpen = index === 0;
        return (
          <article class="faq-item">
            <h3>
              <button
                id={buttonId}
                type="button"
                data-faq
                aria-expanded={initiallyOpen ? 'true' : 'false'}
                aria-controls={panelId}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{question}</strong>
                <i aria-hidden="true">+</i>
              </button>
            </h3>
            <div id={panelId} role="region" aria-labelledby={buttonId} hidden={!initiallyOpen}>
              <p>{answer}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-faq]');
    if (!(button instanceof HTMLButtonElement)) return;
    if (button.getAttribute('aria-expanded') === 'true') return;

    document.querySelectorAll('[data-faq][aria-expanded="true"]').forEach((otherButton) => {
      if (otherButton === button) return;
      otherButton.setAttribute('aria-expanded', 'false');
      const panelId = otherButton.getAttribute('aria-controls');
      if (!panelId) return;
      const panel = document.getElementById(panelId);
      if (panel) panel.hidden = true;
    });
  }, true);
</script>