---
import { business } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=2400&q=88"
      alt=""
      width="2400"
      height="1600"
      fetchpriority="high"
      decoding="async"
      data-hero-image
    />
  </div>
  <div class="hero__shade"></div>

  <div class="shell hero__content">
    <div class="hero__lead" data-hero-lead>
      <span class="eyebrow eyebrow--light">Rodzinna multiagencja od {business.foundedYear} roku</span>
      <h1 id="hero-title">Dobra ochrona <em>zaczyna się od rozmowy</em></h1>
      <p>Porównujemy oferty wielu towarzystw i jasno pokazujemy najważniejsze różnice.</p>
      <div class="hero__actions">
        <a class="btn btn--red btn--large" href="#kontakt">Porównaj oferty</a>
        <a class="btn btn--glass btn--large" href={`tel:${business.primaryTel}`}>Zadzwoń</a>
      </div>
    </div>

    <aside class="hero__trust" aria-label="Najważniejsze informacje" data-hero-trust>
      <div><strong>40+</strong><span>towarzystw</span></div>
      <div><strong>24 lata</strong><span>doświadczenia</span></div>
      <div><strong>2 biura</strong><span>Kalisz i Krotoszyn</span></div>
    </aside>
  </div>

  <a class="hero__scroll" href="#dalej" aria-label="Przejdź do kolejnej sekcji"><span></span>Przewiń</a>
</section>

<section class="partners" aria-label="Towarzystwa ubezpieczeniowe">
  <div class="partners__track" aria-hidden="true">
    {['PZU', 'WARTA', 'ERGO HESTIA', 'ALLIANZ', 'GENERALI', 'COMPENSA', 'UNIQA', 'SIGNAL IDUNA', 'WIENER', 'LINK4', 'PZU', 'WARTA', 'ERGO HESTIA', 'ALLIANZ', 'GENERALI', 'COMPENSA', 'UNIQA', 'SIGNAL IDUNA', 'WIENER', 'LINK4'].map((name) => <span>{name}</span>)}
  </div>
</section>

<figure class="photo-break photo-break--contained" id="dalej" data-reveal="clip">
  <img
    src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=2400&q=88"
    alt="Rozmowa klienta z doradcą ubezpieczeniowym"
    width="2400"
    height="1600"
    loading="lazy"
    decoding="async"
    data-parallax
  />
</figure>
