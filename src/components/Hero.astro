---
import { business } from '../data/site';

const partners = [
  {
    id: 'pzu',
    name: 'PZU',
    logo: 'https://upload.wikimedia.org/wikipedia/en/thumb/a/a1/Powszechny_Zak%C5%82ad_Ubezpiecze%C5%84_logo.svg/250px-Powszechny_Zak%C5%82ad_Ubezpiecze%C5%84_logo.svg.png',
    kind: 'image',
  },
  {
    id: 'warta',
    name: 'Warta',
    logo: 'https://www.google.com/s2/favicons?domain_url=https%3A%2F%2Fwww.warta.pl&sz=256',
    wordmark: 'warta.',
    kind: 'wordmark',
  },
  {
    id: 'ergo-hestia',
    name: 'ERGO Hestia',
    logo: 'https://upload.wikimedia.org/wikipedia/de/thumb/1/11/Ergo_Group_logo.svg/250px-Ergo_Group_logo.svg.png',
    wordmark: 'HESTIA',
    kind: 'combined',
  },
  {
    id: 'allianz',
    name: 'Allianz',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Allianz.svg/250px-Allianz.svg.png',
    kind: 'image',
  },
  {
    id: 'generali',
    name: 'Generali',
    logo: 'https://upload.wikimedia.org/wikipedia/en/thumb/2/25/Assicurazioni_Generali_logo.svg/250px-Assicurazioni_Generali_logo.svg.png',
    kind: 'image',
  },
  {
    id: 'compensa',
    name: 'Compensa',
    logo: 'https://www.google.com/s2/favicons?domain_url=https%3A%2F%2Fwww.compensa.pl&sz=256',
    wordmark: 'COMPENSA',
    kind: 'wordmark',
  },
  {
    id: 'uniqa',
    name: 'UNIQA',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Uniqa_Insurance_Group_logo.svg/250px-Uniqa_Insurance_Group_logo.svg.png',
    kind: 'image',
  },
  {
    id: 'signal-iduna',
    name: 'SIGNAL IDUNA',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Signal-iduna.svg/250px-Signal-iduna.svg.png',
    kind: 'image',
  },
  {
    id: 'wiener',
    name: 'Wiener',
    logo: 'https://upload.wikimedia.org/wikipedia/en/thumb/e/eb/Wiener_St%C3%A4dtische.svg/250px-Wiener_St%C3%A4dtische.svg.png',
    kind: 'image',
  },
  {
    id: 'link4',
    name: 'LINK4',
    logo: 'https://www.google.com/s2/favicons?domain_url=https%3A%2F%2Fwww.link4.pl&sz=256',
    wordmark: 'LINK4',
    kind: 'wordmark',
  },
];
---

<section class="hero hero--editorial" aria-labelledby="hero-title">
  <div class="shell hero__frame">
    <div class="hero__mast" aria-label="Informacje o firmie">
      <span>Zimmermann / multiagencja ubezpieczeniowa</span>
      <span>Kalisz · Krotoszyn · od {business.foundedYear}</span>
    </div>

    <div class="hero__editorial-grid">
      <div class="hero__lead" data-hero-lead>
        <span class="hero__meta">{business.foundedYear} / Kalisz + Krotoszyn</span>
        <h1 id="hero-title">
          <span>Dobra ochrona</span>
          <span>zaczyna się</span>
          <em>od rozmowy.</em>
        </h1>
        <p>
          Porównujemy nie tylko składkę. Sprawdzamy zakres, wyłączenia i warunki,
          które mogą mieć znaczenie wtedy, gdy naprawdę potrzebujesz ubezpieczenia.
        </p>
        <div class="hero__actions">
          <a class="btn btn--red btn--large" href="#kontakt">Porównaj oferty</a>
          <a class="hero__phone" href={`tel:${business.primaryTel}`}>
            <span>Zadzwoń</span>
            <strong>{business.primaryPhone}</strong>
          </a>
        </div>
      </div>

      <div class="hero__visual" data-reveal="clip">
        <figure class="hero__portrait">
          <img
            src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1600&q=88"
            alt="Zespół doradców podczas spotkania w biurze"
            width="1600"
            height="2000"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <span class="hero__photo-index" aria-hidden="true">01 / Rozmowa</span>

        <aside class="hero-analysis" aria-label="Elementy porównania ofert" data-hero-trust>
          <span>Jak porównujemy</span>
          <ol>
            <li><b>01</b><strong>Cenę</strong></li>
            <li><b>02</b><strong>Zakres ochrony</strong></li>
            <li><b>03</b><strong>Wyłączenia</strong></li>
            <li><b>04</b><strong>Pomoc po szkodzie</strong></li>
          </ol>
        </aside>
      </div>
    </div>

    <div class="hero__proof" aria-label="Najważniejsze informacje" data-reveal-group>
      <div><strong>40+</strong><span>towarzystw w porównaniu</span></div>
      <div><strong>Od {business.foundedYear}</strong><span>rodzinna multiagencja</span></div>
      <div><strong>2 biura</strong><span>Kalisz i Krotoszyn</span></div>
    </div>
  </div>

  <a class="hero__scroll" href="#dalej" aria-label="Przejdź do kolejnej sekcji"><span></span>Przewiń</a>
</section>

<section class="partners" aria-label="Towarzystwa ubezpieczeniowe">
  <p class="sr-only">PZU, Warta, ERGO Hestia, Allianz, Generali, Compensa, UNIQA, SIGNAL IDUNA, Wiener i LINK4</p>
  <div class="partners__track" aria-hidden="true">
    {[0, 1].map((groupIndex) => (
      <div class="partners__group" aria-hidden={groupIndex === 1 ? 'true' : undefined}>
        {partners.map((partner) => (
          <span class:list={['partner-logo', `partner-logo--${partner.id}`, { 'partner-logo--wordmark': partner.kind === 'wordmark', 'partner-logo--combined': partner.kind === 'combined' }]}>
            <img
              src={partner.logo}
              alt=""
              width="250"
              height="100"
              loading="eager"
              decoding="async"
              referrerpolicy="no-referrer"
            />
            {partner.wordmark && <strong>{partner.wordmark}</strong>}
          </span>
        ))}
      </div>
    ))}
  </div>
</section>

<figure class="photo-break photo-break--contained" id="dalej" data-reveal="clip">
  <img
    src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=2400&q=88"
    alt="Zespół pracowników podczas spotkania w nowoczesnym biurze"
    width="2400"
    height="1600"
    loading="lazy"
    decoding="async"
    data-parallax
  />
</figure>