---
---
<section class="relative bg-white py-16 md:py-24 lg:py-28 overflow-hidden">
  <div class="main-grid-container relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">

    <!-- Kolumna Tekstowa -->
    <div class="lg:col-span-6 flex flex-col gap-8 text-center lg:text-left">

      <!-- Badge -->
      <div class="flex items-center justify-center lg:justify-start gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-red animate-pulse"></span>
        <span class="text-sm font-bold text-brand-red uppercase tracking-widest">Partner Unilink S.A.</span>
      </div>

      <!-- Nagłówek -->
      <h1 class="font-serif font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.08] text-brand-blue tracking-tight">
        Ubezpieczenia, które <span class="text-brand-red">chronią</span> to, co ważne.
      </h1>

      <p class="text-lg sm:text-xl text-slate-500 leading-relaxed max-w-xl mx-auto lg:mx-0">
        Porównujemy oferty <strong class="text-slate-700">ponad 40 wiodących towarzystw</strong>.
        Dobierzemy najtańsze ubezpieczenie dopasowane do Twoich potrzeb.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row items-center lg:items-start gap-4 pt-1">
        <button
          id="hero-cta"
          class="inline-flex items-center gap-2.5 bg-brand-red text-white text-lg font-bold px-8 py-4 rounded-xl transition-all duration-300 hover:bg-brand-red-dark hover:-translate-y-0.5 shadow-lg shadow-brand-red/20 cursor-pointer"
        >
          Darmowa wycena
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
        <a
          href="tel:502252048"
          class="inline-flex items-center gap-2 text-brand-blue text-base font-semibold px-6 py-4 rounded-xl border border-slate-200 hover:border-brand-red hover:text-brand-red transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M20 22.621l-3.521-6.795c-.008.004-1.974.97-2.064 1.011-2.24 1.086-6.753-7.859-4.161-9.13l2.066-1.011-3.52-6.796-2 1c-6.047 2.972-2.055 18.5 5.921 22.5 7.981 4 11.279-5.779 11.279-5.779l-2-1z"/>
          </svg>
          Zadzwoń do nas
        </a>
      </div>

      <!-- Kategoryzacja -->
      <div class="grid grid-cols-5 gap-2 pt-2">
        <button data-target="komunikacyjne" class="hero-select-btn flex items-center justify-center gap-2 py-2.5 rounded-lg bg-slate-100/80 text-sm font-semibold text-slate-500 hover:bg-brand-red hover:text-white transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10M13 16h6a1 1 0 001-1v-4a1 1 0 00-.384-.788l-3.328-2.662A1 1 0 0015.656 7H13" />
          </svg>
          <span>Auto</span>
        </button>
        <button data-target="dom" class="hero-select-btn flex items-center justify-center gap-2 py-2.5 rounded-lg bg-slate-100/80 text-sm font-semibold text-slate-500 hover:bg-brand-red hover:text-white transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Dom</span>
        </button>
        <button data-target="firma" class="hero-select-btn flex items-center justify-center gap-2 py-2.5 rounded-lg bg-slate-100/80 text-sm font-semibold text-slate-500 hover:bg-brand-red hover:text-white transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Firma</span>
        </button>
        <button data-target="zycie" class="hero-select-btn flex items-center justify-center gap-2 py-2.5 rounded-lg bg-slate-100/80 text-sm font-semibold text-slate-500 hover:bg-brand-red hover:text-white transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span>Życie</span>
        </button>
        <button data-target="rolne" class="hero-select-btn flex items-center justify-center gap-2 py-2.5 rounded-lg bg-slate-100/80 text-sm font-semibold text-slate-500 hover:bg-brand-red hover:text-white transition-all duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
          <span>Rolne</span>
        </button>
      </div>
    </div>

    <!-- Kolumna Graficzna -- Parasolka -->
    <div class="lg:col-span-6 flex justify-center items-center relative">
      <!-- Dekoracyjne tło -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[460px] h-[460px] rounded-full bg-brand-red/5"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[370px] h-[370px] rounded-full bg-brand-red/5"></div>

      <!-- Zdjęcie parasolki -->
      <div class="relative w-[340px] h-[340px] sm:w-[400px] sm:h-[400px] lg:w-[480px] lg:h-[480px] rounded-full overflow-hidden shadow-2xl shadow-brand-red/10 border-4 border-white">
        <img
          src="/hero-family.png"
          alt="Rodzina pod czerwonym parasolem - symbol ochrony Ubezpieczenia Zimmermann"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Floating badge: doświadczenie -->
      <div class="absolute -bottom-2 -left-2 sm:bottom-6 sm:left-0 bg-white rounded-2xl shadow-xl px-6 py-4 border border-slate-100 flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-brand-blue flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="font-display font-extrabold text-xl text-brand-blue leading-none">24 lata</p>
          <p class="text-xs text-slate-400 font-medium mt-0.5">doświadczenia</p>
        </div>
      </div>

      <!-- Floating badge: towarzystwa -->
      <div class="absolute -top-2 -right-2 sm:top-6 sm:right-0 bg-white rounded-2xl shadow-xl px-6 py-4 border border-slate-100 flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-brand-red flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </div>
        <div>
          <p class="font-display font-extrabold text-xl text-brand-blue leading-none">40+</p>
          <p class="text-xs text-slate-400 font-medium mt-0.5">towarzystw</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Marquee logotypów -->
<div class="bg-slate-50 border-y border-slate-100 py-6 overflow-hidden">
  <div id="marquee-track" class="flex items-center gap-12" style="width: max-content;">
    <span class="font-display font-extrabold text-2xl tracking-wider text-slate-300 whitespace-nowrap">PZU</span>
    <span class="font-display font-bold text-2xl tracking-wide text-slate-300 whitespace-nowrap">WARTA</span>
    <span class="font-display font-black text-2xl tracking-tight text-slate-300 whitespace-nowrap">ERGO HESTIA</span>
    <span class="font-display font-semibold text-2xl text-slate-300 whitespace-nowrap">ALLIANZ</span>
    <span class="font-display font-semibold text-2xl text-slate-300 whitespace-nowrap">GENERALI</span>
    <span class="font-display font-bold text-2xl tracking-wide text-slate-300 whitespace-nowrap">COMPENSA</span>
    <span class="font-display font-semibold text-2xl text-slate-300 whitespace-nowrap">LINK4</span>
    <span class="font-display font-bold text-2xl tracking-wide text-slate-300 whitespace-nowrap">UNIQA</span>
    <span class="font-display font-semibold text-2xl text-slate-300 whitespace-nowrap">SIGNAL IDUNA</span>
    <span class="font-display font-bold text-2xl text-slate-300 whitespace-nowrap">WIENER</span>
  </div>
</div>

<script>
  const cta = document.getElementById('hero-cta');
  const buttons = document.querySelectorAll('.hero-select-btn');
  const targetFormSelect = document.getElementById('type') as HTMLSelectElement | null;
  const contactSection = document.getElementById('kontakt');

  cta?.addEventListener('click', () => {
    contactSection?.scrollIntoView({ behavior: 'smooth' });
  });

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const targetValue = button.getAttribute('data-target');

      if (targetFormSelect && targetValue) {
        targetFormSelect.value = targetValue;
      }

      contactSection?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Marquee
  const track = document.getElementById('marquee-track');
  if (track) {
    // Sklonuj zawartość 3x żeby zawsze wypełniało ekran
    const children = Array.from(track.children);
    for (let i = 0; i < 3; i++) {
      children.forEach(child => {
        track.appendChild(child.cloneNode(true));
      });
    }

    // Zmierz szerokość jednego zestawu (oryginalne dzieci)
    const oneSetWidth = children.reduce((acc, el) => {
      return acc + (el as HTMLElement).offsetWidth + 48; // 48 = gap-12
    }, 0);

    let position = 0;
    const speed = 0.8; // px per frame

    function animateMarquee() {
      position -= speed;
      if (Math.abs(position) >= oneSetWidth) {
        position += oneSetWidth;
      }
      track.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(animateMarquee);
    }

    requestAnimationFrame(animateMarquee);
  }
</script>
