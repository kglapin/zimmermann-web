---
import { business } from '../data/site';
---

<footer class="footer">
  <div class="footer__word" aria-hidden="true">ZIMMERMANN</div>

  <div class="shell footer__grid">
    <div>
      <a class="brand brand--footer" href="/#start" aria-label="Powrót na początek strony">
        <img src="/logo.jpg" alt="" width="52" height="52" />
        <span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span>
      </a>
      <p>Rodzinna multiagencja w Kaliszu i Krotoszynie.</p>
    </div>

    <div>
      <h2>Oferta</h2>
      <a href="/#oferta">Samochód</a>
      <a href="/#oferta">Dom i mieszkanie</a>
      <a href="/#oferta">Życie i zdrowie</a>
      <a href="/#oferta">Firma</a>
      <a href="/#oferta">Rolnictwo</a>
      <a href="/#oferta">Podróże</a>
    </div>

    <div>
      <h2>Kontakt</h2>
      <a href={`tel:${business.primaryTel}`}>Kalisz: {business.primaryPhone}</a>
      <a href="tel:+48502252048">Krotoszyn: 502 252 048</a>
      <a href="/#lokalnie">Adresy i mapy</a>
      <a href="/polityka-prywatnosci/">Polityka prywatności</a>
    </div>
  </div>

  <div class="shell footer__bottom">
    <span>© 2026 Ubezpieczenia Zimmermann</span>
    <span>Partner Unilink S.A.</span>
  </div>
</footer>

<div class="mobile-bar" aria-label="Szybki kontakt">
  <a href={`tel:${business.primaryTel}`}><small>Telefon</small><strong>{business.primaryPhone}</strong></a>
  <a href="/#kontakt">Wycena</a>
</div>
