---
import { business } from '../data/site';
---

<div class="topbar">
  <div class="shell topbar__inner">
    <span>Kalisz · Krotoszyn · obsługa stacjonarna i zdalna</span>
    <a href="#szkoda">Pomoc po szkodzie</a>
  </div>
</div>

<header class="header" data-header>
  <div class="progress" data-progress aria-hidden="true"></div>
  <div class="shell header__inner">
    <a class="brand" href="#start" aria-label="Ubezpieczenia Zimmermann — strona główna">
      <img src="/logo.jpg" alt="" width="52" height="52" />
      <span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Główna nawigacja">
      <a href="#oferta">Oferta</a>
      <a href="#proces">Jak pracujemy</a>
      <a href="#szkoda">Po szkodzie</a>
      <a href="#lokalnie">Lokalnie</a>
      <a href="#opinie">Opinie</a>
      <a href="#kontakt">Kontakt</a>
    </nav>

    <div class="header__actions">
      <a class="phone" href={`tel:${business.primaryTel}`}>{business.primaryPhone}</a>
      <a class="btn btn--red" href="#kontakt">Porównaj oferty</a>
      <button
        class="menu"
        type="button"
        data-menu
        aria-label="Otwórz menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-navigation" class="mobile-nav" data-mobile-nav aria-label="Nawigacja mobilna" hidden>
    <a href="#oferta">Oferta</a>
    <a href="#proces">Jak pracujemy</a>
    <a href="#szkoda">Pomoc po szkodzie</a>
    <a href="#lokalnie">Lokalnie</a>
    <a href="#opinie">Opinie</a>
    <a href="#kontakt">Kontakt</a>
  </nav>
</header>
