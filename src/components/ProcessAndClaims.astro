---
import { business, claimSteps, processSteps } from '../data/site';
---

<section class="process" id="proces" aria-labelledby="process-title">
  <div class="shell process__grid">
    <figure class="process__photo" data-reveal="left">
      <img
        src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1800&q=86"
        alt="Zespół podczas rozmowy"
        width="1800"
        height="1350"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="process__content" data-reveal="right">
      <span class="section-kicker section-kicker--light">
        <span class="section-kicker__index" aria-hidden="true">03</span>
        <span class="section-kicker__label">Jak pracujemy</span>
      </span>
      <h2 id="process-title">Prosto i bez presji</h2>
      <div class="steps" data-reveal-group>
        {processSteps.map(([title, text], index) => (
          <article class="step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="claims" id="szkoda" aria-labelledby="claims-title">
  <div class="shell">
    <header class="claims__intro">
      <div data-reveal="left">
        <span class="section-kicker">
          <span class="section-kicker__index" aria-hidden="true">04</span>
          <span class="section-kicker__label">Po szkodzie</span>
        </span>
        <h2 id="claims-title">Jasny plan działania</h2>
      </div>
      <p data-reveal="right">Pomagamy uporządkować pierwsze kroki i wybrać właściwy sposób zgłoszenia.</p>
    </header>

    <div class="claims__stage">
      <figure class="claims__media" data-reveal="clip">
        <img
          src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=2000&q=88"
          alt="Samochód na drodze"
          width="2000"
          height="1333"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Jedna rozmowa. Konkretne kolejne kroki</figcaption>
      </figure>

      <div class="claims__panel" data-reveal="right">
        <ol class="claims__steps" data-reveal-group>
          {claimSteps.map(([title, text], index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{title}</strong><p>{text}</p></div>
            </li>
          ))}
        </ol>
        <div class="claims__actions">
          <a class="btn btn--red" href={`tel:${business.primaryTel}`}>Zadzwoń po pomoc</a>
          <a class="text-link text-link--light" href="#kontakt">Kontakt <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="stats" aria-label="Najważniejsze liczby">
  <div class="shell stats__grid" data-reveal-group>
    <div><strong data-counter="40" data-counter-suffix="+">0</strong><span>towarzystw</span></div>
    <div><strong data-counter="24">0</strong><span>lata doświadczenia</span></div>
    <div><strong data-counter="2">0</strong><span>biura</span></div>
    <div><strong>5.0</strong><span>średnia ocen</span></div>
  </div>
</section>