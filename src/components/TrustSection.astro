---
const stats = [
  { value: '40+', label: 'Towarzystw ubezpieczeniowych w ofercie' },
  { value: '24', label: 'Lata doświadczenia w branży' },
  { value: '5.0', label: 'Ocena od naszych klientów' }
];

const benefits = [
  {
    title: 'Wszystko w 1 miejscu',
    description: 'Nie musisz dzwonić do kilku firm ani przeglądać dziesiątek stron. U nas porównasz i kupisz ubezpieczenie w kilka minut.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  {
    title: 'Niezależni doradcy',
    description: 'Nie reprezentujemy tylko jednego towarzystwa. Reprezentujemy Ciebie. Wybieramy to, co jest faktycznie korzystne i bezpieczne dla Twojego budżetu.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`
  },
  {
    title: 'Pomoc w likwidacji szkód',
    description: 'Nasz kontakt z Tobą nie kończy się na wystawieniu polisy. W przypadku wystąpienia szkody, pomożemy Ci przejść przez proces zgłoszenia i wypłaty odszkodowania.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`
  }
];
---

<section id="dlaczego-my" class="py-16 md:py-24 bg-white relative scroll-mt-20">
  <div class="main-grid-container flex flex-col gap-16">
    <!-- Górny segment: Info i zalety -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Kolumna lewa (Tytuły) -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <span class="text-xs font-bold text-brand-red uppercase tracking-widest">Twoje bezpieczeństwo to nasz priorytet</span>
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl md:text-4xl text-brand-blue leading-tight tracking-tight">
          Dlaczego warto powierzyć ubezpieczenia właśnie nam?
        </h2>
        <div class="w-12 h-1 bg-brand-red rounded mt-2"></div>
        <p class="text-sm text-slate-500 font-sans leading-relaxed mt-2">
          Jesteśmy rodzinną multiagencją i partnerem <strong class="text-brand-blue">Unilink S.A.</strong> -- największej sieci multiagencji w Polsce. Dla nas najważniejsza jest relacja i zaufanie. Zapewniamy profesjonalizm, pełne doradztwo oraz bezstresowy wybór odpowiedniego ubezpieczenia.
        </p>
      </div>

      <!-- Kolumna prawa (Zalety w kafelkach) -->
      <div class="md:col-span-7 flex flex-col gap-5">
        {benefits.map((benefit) => (
          <div class="flex gap-4 p-5 rounded-2xl border border-slate-100 hover:border-slate-200/80 hover:shadow-md hover:shadow-slate-50 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-brand-red-light flex items-center justify-center shrink-0">
              <Fragment set:html={benefit.icon} />
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="font-display font-bold text-base text-brand-blue">
                {benefit.title}
              </h3>
              <p class="text-sm text-slate-500 font-sans leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Dolny segment: Liczby mówią za siebie -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-10 border-t border-slate-100">
      {stats.map((stat) => (
        <div class="text-center p-6 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col gap-1 transition-transform duration-300 hover:scale-102">
          <span class="font-display font-extrabold text-3xl md:text-4xl text-brand-red leading-none">
            {stat.value}
          </span>
          <span class="text-xs font-semibold text-brand-blue uppercase tracking-wider mt-1.5 leading-snug">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
