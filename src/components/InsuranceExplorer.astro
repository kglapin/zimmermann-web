---
import { services } from '../data/site';
const first = services[0];
---

<section class="section offer" id="oferta" aria-labelledby="offer-title">
  <div class="shell">
    <header class="section-heading" data-reveal="up">
      <span class="section-kicker">
        <span class="section-kicker__index" aria-hidden="true">02</span>
        <span class="section-kicker__label">Oferta</span>
      </span>
      <h2 id="offer-title">Co chcesz ubezpieczyć?</h2>
    </header>

    <div class="offer__layout">
      <div class="service-tabs" role="tablist" aria-label="Rodzaje ubezpieczeń" data-reveal-group>
        {services.map((service, index) => (
          <button
            id={`tab-${service.id}`}
            type="button"
            class:list={['service-tab', { active: index === 0 }]}
            data-service-tab
            data-service-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="service-panel"
            tabindex={index === 0 ? '0' : '-1'}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{service.title}</strong>
            <i aria-hidden="true">↗</i>
          </button>
        ))}
      </div>

      <article
        id="service-panel"
        class="service-panel"
        data-service-panel
        role="tabpanel"
        aria-labelledby={`tab-${first.id}`}
        tabindex="0"
        data-reveal="right"
      >
        <figure class="service-panel__image" data-service-image-wrap data-service-id={first.id}>
          <img
            src={first.image}
            alt={first.alt}
            width="1800"
            height="1200"
            loading="lazy"
            decoding="async"
            data-service-image
          />
        </figure>
        <div class="service-panel__copy">
          <span class="eyebrow" data-service-subtitle>{first.subtitle}</span>
          <h3 data-service-title>{first.title}</h3>
          <p data-service-description>{first.description}</p>
          <ul data-service-points>{first.points.map((point) => <li>{point}</li>)}</ul>
          <button class="link-button" type="button" data-select-service data-service-value={first.title}>
            Poproś o porównanie <span aria-hidden="true">→</span>
          </button>
        </div>
      </article>
    </div>
  </div>

  <script type="application/json" data-services set:html={JSON.stringify(services)}></script>
</section>

<figure class="photo-break photo-break--full" data-reveal="clip">
  <img
    src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=2400&q=88"
    alt="Spokojne, nowoczesne wnętrze domu"
    width="2400"
    height="1600"
    loading="lazy"
    decoding="async"
    data-parallax
  />
  <figcaption>Ochrona dopasowana do życia</figcaption>
</figure>