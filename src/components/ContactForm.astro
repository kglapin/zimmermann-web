---
---
<section id="kontakt" class="py-16 md:py-24 bg-slate-50 relative scroll-mt-20">
  <div class="main-grid-container flex flex-col gap-12">
    <!-- Header sekcji -->
    <div class="text-center max-w-xl mx-auto flex flex-col gap-3">
      <span class="text-xs font-bold text-brand-red uppercase tracking-widest">Szybki kontakt</span>
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl md:text-4xl text-brand-blue leading-tight tracking-tight">
        Zadzwoń lub wyślij zapytanie
      </h2>
      <div class="w-12 h-1 bg-brand-red mx-auto rounded mt-2"></div>
      <p class="text-sm text-slate-500 font-sans leading-relaxed mt-2">
        Masz pytania? Chcesz poznać wycenę ubezpieczenia? Wypełnij formularz poniżej, a my oddzwonimy z gotową, najtańszą ofertą.
      </p>
    </div>

    <!-- Siatka formularza i danych -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">
      <!-- Kolumna lewa: Dane i Mapa -->
      <div class="md:col-span-5 flex flex-col gap-6">
        <!-- Wizytówka kontaktowa -->
        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col gap-5">
          <h3 class="font-display font-bold text-lg text-brand-blue border-b border-slate-100 pb-3">
            Dane kontaktowe
          </h3>

          <div class="flex flex-col gap-4 text-sm font-sans">
            <!-- Adres Kalisz -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-brand-red-light text-brand-red flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-brand-blue">Biuro Kalisz</span>
                <span class="text-slate-500">ul. Konopnickiej 3-5, lok. 10</span>
                <span class="text-slate-500">62-800 Kalisz</span>
              </div>
            </div>

            <!-- Adres Krotoszyn -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-brand-red-light text-brand-red flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-brand-blue">Biuro Krotoszyn</span>
                <span class="text-slate-500">ul. Piastowska 30</span>
                <span class="text-slate-500">63-700 Krotoszyn</span>
              </div>
            </div>

            <!-- Telefony -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-brand-red-light text-brand-red flex items-center justify-center shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="flex flex-col gap-1.5">
                <span class="font-semibold text-brand-blue">Telefony bezpośrednie</span>
                <a href="tel:789315400" class="text-slate-600 hover:text-brand-red font-medium transition-colors">
                  789 315 400 <span class="text-xs text-slate-400">(Biuro Kalisz)</span>
                </a>
                <a href="tel:502252048" class="text-slate-600 hover:text-brand-red font-medium transition-colors">
                  502 252 048 <span class="text-xs text-slate-400">(Rafał Zimmermann)</span>
                </a>
                <a href="tel:506092200" class="text-slate-600 hover:text-brand-red font-medium transition-colors">
                  506 092 200 <span class="text-xs text-slate-400">(Igor Zimmermann)</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Mapa -->
        <div class="bg-white rounded-2xl p-2 border border-slate-100 shadow-sm overflow-hidden h-[220px] md:h-auto md:grow relative">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2455.5!2d18.085!3d51.76!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ac5f0b111be17%3A0x123456!2sKonopnickiej+3-5%2C+62-800+Kalisz!5e0!3m2!1spl!2spl"
            class="w-full h-full rounded-xl border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokalizacja Ubezpieczenia Zimmermann Kalisz"
          ></iframe>
        </div>
      </div>

      <!-- Kolumna prawa: Formularz kontaktowy -->
      <div class="md:col-span-7 bg-white rounded-2xl p-6 md:p-8 border border-slate-100 shadow-sm">
        <form id="insurance-form" class="flex flex-col gap-5 text-sm font-sans">
          <!-- Imię i Nazwisko -->
          <div class="flex flex-col gap-1.5">
            <label for="name" class="font-semibold text-brand-blue">Imię i Nazwisko</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="np. Jan Kowalski"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:border-brand-red focus:ring-2 focus:ring-brand-red-light transition-all"
            />
          </div>

          <!-- Telefon i Typ ubezpieczenia w rzędzie -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="phone" class="font-semibold text-brand-blue">Numer telefonu</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="np. 500 600 700"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:border-brand-red focus:ring-2 focus:ring-brand-red-light transition-all"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="type" class="font-semibold text-brand-blue">Rodzaj ubezpieczenia</label>
              <select
                id="type"
                name="type"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:border-brand-red focus:ring-2 focus:ring-brand-red-light bg-white transition-all"
              >
                <option value="" disabled selected>Wybierz z listy...</option>
                <option value="komunikacyjne">Komunikacyjne (OC/AC)</option>
                <option value="dom">Dom i Mieszkanie</option>
                <option value="zycie">Na Życie i Zdrowie</option>
                <option value="firma">Dla Firm / Biznesu</option>
                <option value="rolne">Rolne i Upraw</option>
                <option value="turystyczne">Turystyczne (Podróżne)</option>
                <option value="medyczne">Opieka Medyczna</option>
                <option value="kredyty">Kredyty i Finansowanie</option>
                <option value="sukcesyjne">Ubezpieczenia Sukcesyjne</option>
                <option value="inne">Inne ubezpieczenie</option>
              </select>
            </div>
          </div>

          <!-- Treść zapytania -->
          <div class="flex flex-col gap-1.5">
            <label for="message" class="font-semibold text-brand-blue">Twoja wiadomość (opcjonalnie)</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Napisz np. kiedy kończy się obecna polisa lub jakie parametry ubezpieczenia Cię interesują..."
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:border-brand-red focus:ring-2 focus:ring-brand-red-light transition-all resize-none"
            ></textarea>
          </div>

          <!-- Zgoda RODO -->
          <div class="flex items-start gap-2.5">
            <input
              type="checkbox"
              id="rodo"
              name="rodo"
              required
              class="mt-1 accent-brand-red cursor-pointer"
            />
            <label for="rodo" class="text-xs text-slate-500 leading-relaxed cursor-pointer select-none">
              Wyrażam zgodę na przetwarzanie moich danych osobowych w celu kontaktu i przygotowania darmowej kalkulacji ubezpieczeniowej.
            </label>
          </div>

          <!-- Przycisk wysyłania -->
          <button
            type="submit"
            class="btn-primary w-full mt-2 font-display py-3 text-base font-bold shadow-lg"
          >
            Zamów darmową kalkulację
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('insurance-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerText;

      submitBtn.disabled = true;
      submitBtn.innerText = 'Trwa wysyłanie...';

      setTimeout(() => {
        submitBtn.style.backgroundColor = '#10B981';
        submitBtn.innerText = 'Dziękujemy! Skontaktujemy się wkrótce.';
        form.reset();

        setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.style.backgroundColor = '';
          submitBtn.innerText = originalText;
        }, 3000);
      }, 1500);
    });
  }
</script>
