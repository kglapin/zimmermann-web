---
<section id="oferta" class="py-16 md:py-24 bg-slate-50 relative scroll-mt-20">
  <div class="main-grid-container flex flex-col gap-12">
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto flex flex-col gap-3">
      <span class="text-xs font-bold text-brand-red uppercase tracking-widest">Szeroki wybór polis</span>
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl md:text-4xl text-brand-blue leading-tight tracking-tight">
        Ubezpieczenia dopasowane do Twoich potrzeb
      </h2>
      <div class="w-12 h-1 bg-brand-red mx-auto rounded mt-2"></div>
      <p class="text-sm text-slate-500 font-sans leading-relaxed mt-2">
        Współpracujemy z największymi ubezpieczycielami w Polsce. Dobieramy warunki i zakres ochrony skrojone pod Twoje indywidualne wymagania.
      </p>
    </div>

    <!-- Tabs + Content -->
    <div class="flex flex-col lg:flex-row gap-6">

      <!-- Lewa: zakładki -->
      <div class="flex lg:flex-col gap-2 overflow-x-auto lg:overflow-visible lg:w-[280px] lg:shrink-0 pb-2 lg:pb-0">
        {services.map((service, i) => (
          <button
            data-tab={i}
            class="service-tab flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-bold whitespace-nowrap transition-all duration-200 cursor-pointer bg-white text-slate-500 border border-slate-100 hover:border-slate-200"
          >
            <span class="shrink-0 w-5 h-5 flex items-center justify-center">
              <Fragment set:html={icons[service.iconName]} />
            </span>
            <span>{service.title}</span>
          </button>
        ))}
      </div>

      <!-- Prawa: panel -->
      <div class="flex-1 min-w-0">
        <div id="service-panel" class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
          <!-- Image -->
          <div class="w-full h-56 sm:h-64 lg:h-72 overflow-hidden bg-slate-100">
            <img
              id="service-image"
              src={services[0].image}
              alt={services[0].title}
              class="w-full h-full object-cover transition-opacity duration-300"
              loading="eager"
            />
          </div>

          <!-- Content -->
          <div class="p-6 md:p-8 flex flex-col gap-5">
            <h3 id="service-title" class="font-display font-extrabold text-xl md:text-2xl text-brand-blue leading-tight">
              {services[0].title}
            </h3>

            <p id="service-desc" class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {services[0].description}
            </p>

            <ul id="service-highlights" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {services[0].highlights.map((h: string) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-600">
                  <Fragment set:html={checkIcon} />
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <a href="#kontakt" class="inline-flex items-center gap-2 bg-brand-red text-white text-sm font-bold px-6 py-3 rounded-xl w-fit hover:bg-brand-red-dark hover:-translate-y-0.5 transition-all duration-300 shadow-md shadow-brand-red/10">
              Zamów darmową wycenę
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ services, checkIcon }}>
  const tabs = document.querySelectorAll('.service-tab');
  const image = document.getElementById('service-image');
  const title = document.getElementById('service-title');
  const desc = document.getElementById('service-desc');
  const highlights = document.getElementById('service-highlights');

  function setActive(idx) {
    tabs.forEach((tab, i) => {
      if (i === idx) {
        tab.classList.remove('bg-white', 'text-slate-500', 'border', 'border-slate-100', 'hover:border-slate-200');
        tab.classList.add('bg-brand-red', 'text-white', 'shadow-lg', 'shadow-brand-red/20');
      } else {
        tab.classList.remove('bg-brand-red', 'text-white', 'shadow-lg', 'shadow-brand-red/20');
        tab.classList.add('bg-white', 'text-slate-500', 'border', 'border-slate-100', 'hover:border-slate-200');
      }
    });

    const s = services[idx];
    image.src = s.image;
    image.alt = s.title;
    title.textContent = s.title;
    desc.textContent = s.description;
    highlights.innerHTML = s.highlights.map(h =>
      '<li class="flex items-start gap-2.5 text-sm text-slate-600">' + checkIcon + '<span>' + h + '</span></li>'
    ).join('');
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => setActive(i));
  });

  // Set first tab active on load
  setActive(0);
</script>
