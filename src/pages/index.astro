---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import TrustSection from '../components/TrustSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Ubezpieczenia Zimmermann Kalisz | Doradztwo i Tanie Ubezpieczenia"
	description="Multiagencja Ubezpieczeniowa Zimmermann - Kalisz i Krotoszyn. Partner Unilink S.A. Ponad 40 towarzystw. Ubezpieczenia komunikacyjne (OC/AC), majątkowe, życiowe, rolnicze, medyczne oraz kredyty. 24 lata doświadczenia."
>
	<Header />

	<main class="flex-grow">
		<Hero />
		<Services />
		<Reviews />
		<TrustSection />
		<ContactForm />
	</main>

	<Footer />
</Layout>
