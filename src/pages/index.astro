---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Samochód',
    subtitle: 'OC, AC, NNW i Assistance',
    image: 'https://images.unsplash.com/photo-1493238792000-8113da705763?auto=format&fit=crop&w=1800&q=88',
    description: 'Porównujemy zakres, składkę i najważniejsze różnice między wariantami.',
    points: ['Zakres ochrony', 'Assistance w Polsce i za granicą', 'Pomoc po szkodzie'],
  },
  {
    title: 'Dom i mieszkanie',
    subtitle: 'Majątek i odpowiedzialność',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=88',
    description: 'Dobieramy ochronę murów, wyposażenia i odpowiedzialności prywatnej.',
    points: ['Mury i wyposażenie', 'Zalanie, pożar i przepięcia', 'OC w życiu prywatnym'],
  },
  {
    title: 'Życie i zdrowie',
    subtitle: 'Bezpieczeństwo rodziny',
    image: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=1800&q=88',
    description: 'Pokazujemy warianty dopasowane do sytuacji rodzinnej i budżetu.',
    points: ['Ochrona życia', 'Poważne zachorowania', 'Opieka medyczna'],
  },
  {
    title: 'Firma',
    subtitle: 'Majątek, OC i pracownicy',
    image: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=88',
    description: 'Porządkujemy ryzyka firmy i porównujemy najważniejsze zakresy.',
    points: ['OC działalności', 'Mienie i sprzęt', 'Floty i pracownicy'],
  },
  {
    title: 'Rolnictwo',
    subtitle: 'Gospodarstwo, uprawy i maszyny',
    image: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1800&q=88',
    description: 'Dobieramy ochronę gospodarstwa, budynków, maszyn i upraw.',
    points: ['OC rolnika', 'Budynki i maszyny', 'Uprawy i zwierzęta'],
  },
  {
    title: 'Podróże',
    subtitle: 'Leczenie, bagaż i ratownictwo',
    image: 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=1800&q=88',
    description: 'Sprawdzamy koszty leczenia, ratownictwo i zakres Assistance.',
    points: ['Koszty leczenia', 'Ratownictwo', 'Sport i choroby przewlekłe'],
  },
];

const statementLines = [
  ['Najpierw słuchamy', 'Rozpoznajemy potrzeby.'],
  ['Potem porównujemy', 'Pokazujemy różnice.'],
  ['Zostajemy na dłużej', 'Pomagamy po szkodzie.'],
];

const reviews = [
  ['Marcin Gąsiorek', 'Szybka, fachowa obsługa i konkretne wyjaśnienie różnic między ofertami.'],
  ['Magdalena Gumienna', 'Wszystko sprawnie załatwione. Otrzymałam jasne podpowiedzi i dobre rozwiązanie.'],
  ['Katarzyna Bączkiewicz', 'Duża wiedza, zaangażowanie i polisa dobrze dopasowana do moich potrzeb.'],
];

const faqs = [
  ['Czy porównanie jest bezpłatne?', 'Tak. Rozmowa i przygotowanie wariantów nie zobowiązują do zakupu.'],
  ['Czy polisę można zawrzeć zdalnie?', 'Wiele polis przygotowujemy telefonicznie lub online.'],
  ['Czy pomagacie po szkodzie?', 'Tak. Wskazujemy pierwsze kroki i właściwy sposób zgłoszenia.'],
];
---

<Layout
  title="Ubezpieczenia Zimmermann | Kalisz i Krotoszyn"
  description="Rodzinna multiagencja ubezpieczeniowa. Porównujemy oferty wielu towarzystw i pomagamy również po zakupie polisy."
>
  <div class="topbar">
    <div class="shell">
      <span>Kalisz · Krotoszyn · obsługa stacjonarna i zdalna</span>
      <a href="#szkoda">Pomoc po szkodzie</a>
    </div>
  </div>

  <header class="header">
    <div class="progress" data-progress></div>
    <div class="shell header__inner">
      <a class="brand" href="#start">
        <img src="/logo.jpg" alt="Zimmermann Ubezpieczenia" />
        <span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span>
      </a>

      <nav aria-label="Główna nawigacja">
        <a href="#oferta">Oferta</a>
        <a href="#proces">Jak pracujemy</a>
        <a href="#opinie">Opinie</a>
        <a href="#kontakt">Kontakt</a>
      </nav>

      <div class="header__actions">
        <a class="phone" href="tel:+48789315400">789 315 400</a>
        <a class="btn btn--red" href="#kontakt">Porównaj oferty</a>
        <button class="menu" type="button" data-menu aria-label="Otwórz menu">
          <span></span><span></span>
        </button>
      </div>
    </div>

    <div class="mobile-nav" data-mobile-nav>
      <a href="#oferta">Oferta</a>
      <a href="#proces">Jak pracujemy</a>
      <a href="#szkoda">Pomoc po szkodzie</a>
      <a href="#opinie">Opinie</a>
      <a href="#kontakt">Kontakt</a>
    </div>
  </header>

  <main id="start">
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=2400&q=90"
          alt=""
          data-hero-image
        />
      </div>
      <div class="hero__shade"></div>

      <div class="shell hero__content">
        <div class="hero__lead">
          <span class="eyebrow eyebrow--light">Rodzinna multiagencja od 2002 roku</span>
          <h1>Dobra ochrona<br /><em>zaczyna się od rozmowy.</em></h1>
          <p>Porównujemy oferty wielu towarzystw i jasno pokazujemy różnice.</p>

          <div class="hero__actions">
            <a class="btn btn--red btn--large" href="#kontakt">Porównaj oferty</a>
            <a class="btn btn--glass btn--large" href="tel:+48789315400">Zadzwoń</a>
          </div>
        </div>

        <div class="hero__trust" aria-label="Najważniejsze informacje">
          <div><strong>40+</strong><span>towarzystw</span></div>
          <div><strong>24 lata</strong><span>doświadczenia</span></div>
          <div><strong>2 biura</strong><span>Kalisz i Krotoszyn</span></div>
        </div>
      </div>

      <a class="hero__scroll" href="#dalej" aria-label="Przejdź dalej"><span></span>Przewiń</a>
    </section>

    <section class="logos" aria-label="Towarzystwa ubezpieczeniowe">
      <div class="logos__track">
        {['PZU', 'WARTA', 'ERGO HESTIA', 'ALLIANZ', 'GENERALI', 'COMPENSA', 'UNIQA', 'SIGNAL IDUNA', 'WIENER', 'LINK4', 'PZU', 'WARTA', 'ERGO HESTIA', 'ALLIANZ', 'GENERALI', 'COMPENSA', 'UNIQA', 'SIGNAL IDUNA', 'WIENER', 'LINK4'].map((name) => <span>{name}</span>)}
      </div>
    </section>

    <figure class="wide-shot" id="dalej">
      <img
        src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=2400&q=90"
        alt="Rozmowa z doradcą"
        data-parallax-image
      />
    </figure>

    <section class="statement" data-statement>
      <div class="statement__sticky">
        <div class="shell statement__layout">
          <aside class="statement__rail">
            <span class="eyebrow eyebrow--light">Nasza rola</span>
            <div class="statement__index" aria-hidden="true">
              <strong data-statement-current>01</strong><i></i><span>03</span>
            </div>
            <div class="statement__phases">
              {statementLines.map(([label], index) => (
                <span class:list={['statement__phase', { active: index === 0 }]} data-statement-phase>
                  {label}
                </span>
              ))}
            </div>
          </aside>

          <div class="statement__content">
            <p aria-label={statementLines.map(([, text]) => text).join(' ')}>
              {statementLines.map(([, text]) => (
                <span class="statement__line" data-statement-line>
                  {text.split(' ').map((word) => (
                    <span class="statement__word" data-statement-word>{word}&nbsp;</span>
                  ))}
                </span>
              ))}
            </p>
            <div class="statement__progress" aria-hidden="true"><i data-statement-progress></i></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section explorer" id="oferta">
      <div class="shell">
        <div class="heading heading--compact">
          <span class="eyebrow reveal">Oferta</span>
          <h2 class="reveal">Co chcesz ubezpieczyć?</h2>
        </div>

        <div class="explorer__layout">
          <div class="explorer__nav" role="tablist" aria-label="Rodzaje ubezpieczeń">
            {services.map((service, index) => (
              <button
                type="button"
                class:list={['service-tab', { active: index === 0 }]}
                data-service={index}
                role="tab"
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{service.title}</strong>
                <i>↗</i>
              </button>
            ))}
          </div>

          <article class="service-panel" data-service-panel>
            <div class="service-panel__image">
              <img src={services[0].image} alt={services[0].title} data-service-image />
            </div>

            <div class="service-panel__copy">
              <span class="eyebrow" data-service-subtitle>{services[0].subtitle}</span>
              <h3 data-service-title>{services[0].title}</h3>
              <p data-service-description>{services[0].description}</p>
              <ul data-service-points>
                {services[0].points.map((point) => <li>{point}</li>)}
              </ul>
              <a href="#kontakt" class="link">Poproś o porównanie →</a>
            </div>
          </article>
        </div>
      </div>
      <script type="application/json" data-services set:html={JSON.stringify(services)}></script>
    </section>

    <figure class="editorial-shot">
      <img
        src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=2400&q=90"
        alt="Spokojne wnętrze domu"
        data-parallax-image
      />
      <figcaption>Ochrona dopasowana do życia.</figcaption>
    </figure>

    <section class="process" id="proces">
      <div class="shell process__grid">
        <figure class="process__photo image-reveal">
          <img
            src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1800&q=88"
            alt="Zespół podczas rozmowy"
          />
        </figure>

        <div class="process__content">
          <span class="eyebrow eyebrow--light reveal">Jak pracujemy</span>
          <h2 class="reveal">Prosto i bez presji.</h2>

          <div class="steps">
            {[
              ['Słuchamy', 'Ustalamy, co chcesz zabezpieczyć.'],
              ['Porównujemy', 'Sprawdzamy cenę, zakres i wyłączenia.'],
              ['Wyjaśniamy', 'Pokazujemy najważniejsze różnice.'],
              ['Pomagamy', 'Zostajemy również po zakupie.'],
            ].map(([title, text], index) => (
              <article class="step reveal-card">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{title}</h3><p>{text}</p></div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section claims" id="szkoda">
      <div class="shell claims__inner">
        <figure class="claims__visual image-reveal">
          <img
            src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=1800&q=88"
            alt="Samochód na drodze"
          />
          <span class="note note--1">Zabezpiecz miejsce</span>
          <span class="note note--2">Zbierz dokumenty</span>
          <span class="note note--3">Zadzwoń do doradcy</span>
        </figure>

        <div class="claims__copy">
          <span class="eyebrow reveal">Po szkodzie</span>
          <h2 class="reveal">Pomagamy dalej.</h2>
          <p class="reveal">Wskazujemy pierwsze kroki i właściwy sposób zgłoszenia.</p>
          <div class="claims__actions reveal">
            <a class="btn btn--dark" href="tel:+48789315400">Zadzwoń po pomoc</a>
            <a class="link" href="#kontakt">Kontakt →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="shell stats__grid">
        <div><strong data-counter="40">0</strong><span>towarzystw</span></div>
        <div><strong data-counter="24">0</strong><span>lata doświadczenia</span></div>
        <div><strong data-counter="2">0</strong><span>biura</span></div>
        <div><strong>5.0</strong><span>średnia ocen</span></div>
      </div>
    </section>

    <figure class="team-shot">
      <img
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=2400&q=90"
        alt="Zespół doradców"
        data-parallax-image
      />
      <figcaption>
        <span class="eyebrow eyebrow--light">Lokalnie</span>
        <strong>Kalisz i Krotoszyn.</strong>
      </figcaption>
    </figure>

    <section class="section reviews" id="opinie">
      <div class="shell">
        <div class="heading heading--compact">
          <span class="eyebrow reveal">Opinie</span>
          <h2 class="reveal">Zaufanie w praktyce.</h2>
        </div>

        <div class="reviews__grid">
          {reviews.map(([name, text], index) => (
            <article class:list={['review reveal-card', { 'review--dark': index === 0 }]}>
              <b>“</b>
              <p>{text}</p>
              <footer>
                <i>{name.charAt(0)}</i>
                <span><strong>{name}</strong><small>Opinia klienta</small></span>
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section locations">
      <div class="shell locations__inner">
        <div class="locations__copy">
          <span class="eyebrow reveal">Dwa biura</span>
          <h2 class="reveal">Jesteśmy blisko.</h2>
          <div class="location-tabs">
            <button type="button" class="active" data-location="kalisz">Kalisz</button>
            <button type="button" data-location="krotoszyn">Krotoszyn</button>
          </div>
        </div>

        <div class="location-card active" data-location-card="kalisz">
          <img src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1600&q=88" alt="Wnętrze biura" />
          <div>
            <small>Biuro Kalisz</small>
            <h3>Konopnickiej 3-5</h3>
            <p>lok. 10 · 62-800 Kalisz</p>
            <a class="btn btn--red" href="tel:+48789315400">789 315 400</a>
          </div>
        </div>

        <div class="location-card" data-location-card="krotoszyn">
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=88" alt="Wnętrze biura" />
          <div>
            <small>Biuro Krotoszyn</small>
            <h3>Piastowska 30</h3>
            <p>63-700 Krotoszyn</p>
            <a class="btn btn--red" href="tel:+48502252048">502 252 048</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section faq">
      <div class="shell faq__inner">
        <div class="faq__intro">
          <span class="eyebrow reveal">FAQ</span>
          <h2 class="reveal">Najważniejsze odpowiedzi.</h2>
        </div>

        <div class="faq__list">
          {faqs.map(([question, answer], index) => (
            <article class="faq-item reveal-card">
              <button type="button" data-faq>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{question}</strong>
                <i>+</i>
              </button>
              <div><p>{answer}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="kontakt">
      <div class="shell contact__inner">
        <div class="contact__copy">
          <span class="eyebrow eyebrow--light reveal">Bezpłatne porównanie</span>
          <h2 class="reveal">Zacznijmy od rozmowy.</h2>
          <p class="reveal">Wybierz kategorię i zostaw numer telefonu.</p>
        </div>

        <div class="wizard reveal-card" data-wizard>
          <div data-step="1">
            <small>Krok 1 z 2</small>
            <h3>Co chcesz ubezpieczyć?</h3>
            <div class="wizard__types">
              {services.map((service) => (
                <button type="button" data-type={service.title}>
                  <span>{service.title}</span><i>→</i>
                </button>
              ))}
            </div>
          </div>

          <div data-step="2" hidden>
            <button class="back" type="button" data-back>← Wróć</button>
            <small>Krok 2 z 2</small>
            <h3>Jak możemy się skontaktować?</h3>
            <form>
              <input type="hidden" name="type" />
              <label>Imię<input name="name" required placeholder="Jan" /></label>
              <label>Telefon<input name="phone" type="tel" required placeholder="500 600 700" /></label>
              <label>Informacje dodatkowe<textarea name="message" rows="3" placeholder="Np. data końca polisy"></textarea></label>
              <label class="consent"><input type="checkbox" required /><span>Zgadzam się na kontakt w sprawie wyceny.</span></label>
              <button class="btn btn--red full" type="submit">Przygotuj wiadomość</button>
            </form>
            <div class="status" data-status hidden>
              <strong>Wiadomość została przygotowana.</strong>
              <span>Zadzwoń pod 789 315 400 lub wyślij przygotowany SMS.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer__word">ZIMMERMANN</div>
    <div class="shell footer__grid">
      <div>
        <a class="brand brand--footer" href="#start">
          <img src="/logo.jpg" alt="" />
          <span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span>
        </a>
        <p>Rodzinna multiagencja w Kaliszu i Krotoszynie.</p>
      </div>

      <div>
        <h3>Oferta</h3>
        <a href="#oferta">Samochód</a>
        <a href="#oferta">Dom i mieszkanie</a>
        <a href="#oferta">Życie i zdrowie</a>
        <a href="#oferta">Firma</a>
      </div>

      <div>
        <h3>Kontakt</h3>
        <a href="tel:+48789315400">Kalisz: 789 315 400</a>
        <a href="tel:+48502252048">Rafał: 502 252 048</a>
        <a href="tel:+48506092200">Igor: 506 092 200</a>
      </div>
    </div>

    <div class="shell footer__bottom">
      <span>© 2026 Ubezpieczenia Zimmermann</span>
      <span>Partner Unilink S.A.</span>
    </div>
  </footer>

  <div class="mobile-bar">
    <a href="tel:+48789315400"><small>Telefon</small><strong>789 315 400</strong></a>
    <a href="#kontakt">Wycena</a>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"></script>
  <script is:inline>
    const init = () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menu = document.querySelector('[data-menu]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      const progress = document.querySelector('[data-progress]');

      menu?.addEventListener('click', () => mobileNav?.classList.toggle('open'));
      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileNav.classList.remove('open'));
      });

      addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (progress) progress.style.transform = `scaleX(${max ? scrollY / max : 0})`;
      }, { passive: true });

      document.querySelectorAll('[data-faq]').forEach((button) => {
        button.addEventListener('click', () => button.closest('.faq-item')?.classList.toggle('open'));
      });

      document.querySelectorAll('[data-location]').forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-location');
          document.querySelectorAll('[data-location]').forEach((item) => item.classList.toggle('active', item === button));
          document.querySelectorAll('[data-location-card]').forEach((card) => {
            card.classList.toggle('active', card.getAttribute('data-location-card') === target);
          });
        });
      });

      const serviceData = JSON.parse(document.querySelector('[data-services]')?.textContent || '[]');
      document.querySelectorAll('[data-service]').forEach((button) => {
        button.addEventListener('click', () => {
          const service = serviceData[Number(button.getAttribute('data-service'))];
          const panel = document.querySelector('[data-service-panel]');
          if (!service || !panel) return;

          document.querySelectorAll('[data-service]').forEach((item) => item.classList.toggle('active', item === button));

          const swap = () => {
            panel.querySelector('[data-service-image]').src = service.image;
            panel.querySelector('[data-service-image]').alt = service.title;
            panel.querySelector('[data-service-title]').textContent = service.title;
            panel.querySelector('[data-service-subtitle]').textContent = service.subtitle;
            panel.querySelector('[data-service-description]').textContent = service.description;
            panel.querySelector('[data-service-points]').innerHTML = service.points.map((point) => `<li>${point}</li>`).join('');
          };

          if (window.gsap && !reduce) {
            gsap.to(panel, {
              opacity: 0,
              y: 12,
              duration: 0.18,
              onComplete: () => {
                swap();
                gsap.to(panel, { opacity: 1, y: 0, duration: 0.42, ease: 'power3.out' });
              },
            });
          } else {
            swap();
          }
        });
      });

      const wizard = document.querySelector('[data-wizard]');
      if (wizard) {
        wizard.querySelectorAll('[data-type]').forEach((button) => {
          button.addEventListener('click', () => {
            wizard.querySelector('[name=type]').value = button.getAttribute('data-type');
            wizard.querySelector('[data-step="1"]').hidden = true;
            wizard.querySelector('[data-step="2"]').hidden = false;
          });
        });

        wizard.querySelector('[data-back]')?.addEventListener('click', () => {
          wizard.querySelector('[data-step="2"]').hidden = true;
          wizard.querySelector('[data-step="1"]').hidden = false;
        });

        wizard.querySelector('form')?.addEventListener('submit', (event) => {
          event.preventDefault();
          const formData = new FormData(event.currentTarget);
          const message = `Dzień dobry, proszę o kontakt. Ubezpieczenie: ${formData.get('type')}. Imię: ${formData.get('name')}. Telefon: ${formData.get('phone')}. Informacje: ${formData.get('message') || 'brak'}.`;

          if (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
            location.href = `sms:+48789315400?body=${encodeURIComponent(message)}`;
          } else {
            navigator.clipboard?.writeText(message);
            wizard.querySelector('[data-status]').hidden = false;
          }
        });
      }

      if (reduce || !window.gsap || !window.ScrollTrigger) return;
      gsap.registerPlugin(ScrollTrigger);

      gsap.from('.hero__lead > *', {
        opacity: 0,
        y: 28,
        duration: 0.85,
        stagger: 0.08,
        ease: 'power3.out',
      });

      gsap.from('.hero__trust', {
        opacity: 0,
        y: 24,
        duration: 0.9,
        delay: 0.35,
        ease: 'power3.out',
      });

      gsap.fromTo('[data-hero-image]', { scale: 1.08 }, {
        scale: 1.02,
        duration: 1.6,
        ease: 'power2.out',
      });

      gsap.to('[data-hero-image]', {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1 },
      });

      gsap.utils.toArray('.reveal').forEach((element) => {
        gsap.from(element, {
          opacity: 0,
          y: 24,
          duration: 0.65,
          ease: 'power3.out',
          scrollTrigger: { trigger: element, start: 'top 90%', once: true },
        });
      });

      gsap.utils.toArray('.reveal-card').forEach((element) => {
        gsap.from(element, {
          opacity: 0,
          y: 34,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: element, start: 'top 92%', once: true },
        });
      });

      gsap.utils.toArray('[data-parallax-image]').forEach((image) => {
        gsap.fromTo(image, { yPercent: -5, scale: 1.06 }, {
          yPercent: 5,
          scale: 1.06,
          ease: 'none',
          scrollTrigger: { trigger: image.parentElement, start: 'top bottom', end: 'bottom top', scrub: 1 },
        });
      });

      if (innerWidth > 850) {
        const statement = document.querySelector('[data-statement]');
        const words = gsap.utils.toArray('[data-statement-word]');
        const lines = gsap.utils.toArray('[data-statement-line]');
        const phases = gsap.utils.toArray('[data-statement-phase]');
        const bar = document.querySelector('[data-statement-progress]');
        const current = document.querySelector('[data-statement-current]');

        gsap.set(words, { opacity: 0.12, y: 14, filter: 'blur(4px)' });
        gsap.set(lines, { opacity: 0.5 });
        gsap.set(bar, { scaleX: 0, transformOrigin: 'left center' });

        const setPhase = (phaseIndex) => {
          phases.forEach((phase, index) => phase.classList.toggle('active', index === phaseIndex));
          lines.forEach((line, index) => line.classList.toggle('active', index <= phaseIndex));
          if (current) current.textContent = String(phaseIndex + 1).padStart(2, '0');
        };

        gsap.timeline({
          scrollTrigger: {
            trigger: statement,
            start: 'top top+=82',
            end: 'bottom bottom',
            scrub: 0.65,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const phase = Math.min(phases.length - 1, Math.floor(self.progress * phases.length));
              setPhase(phase);
            },
          },
        })
          .to(words, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1, stagger: 0.045, ease: 'none' }, 0)
          .to(bar, { scaleX: 1, duration: 1, ease: 'none' }, 0);
      }

      document.querySelectorAll('[data-counter]').forEach((element) => {
        const state = { value: 0 };
        const target = Number(element.dataset.counter);
        gsap.to(state, {
          value: target,
          duration: 1.4,
          scrollTrigger: { trigger: element, start: 'top 90%', once: true },
          onUpdate: () => {
            element.textContent = Math.round(state.value) + (target === 40 ? '+' : '');
          },
        });
      });
    };

    document.addEventListener('DOMContentLoaded', init, { once: true });
  </script>
</Layout>
