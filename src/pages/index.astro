---
import Layout from '../layouts/Layout.astro';

const services = [
  { title: 'Samochód', subtitle: 'OC, AC, NNW i Assistance', image: 'https://images.unsplash.com/photo-1493238792000-8113da705763?auto=format&fit=crop&w=1400&q=85', points: ['Porównanie zakresu i ceny', 'Assistance w Polsce i za granicą', 'Pomoc po wystąpieniu szkody'] },
  { title: 'Dom i mieszkanie', subtitle: 'Majątek i odpowiedzialność', image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1400&q=85', points: ['Mury, wyposażenie i instalacje', 'Zalanie, pożar i przepięcia', 'OC w życiu prywatnym'] },
  { title: 'Życie i zdrowie', subtitle: 'Bezpieczeństwo rodziny', image: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=1400&q=85', points: ['Ochrona życia i zdrowia', 'Poważne zachorowania', 'Prywatna opieka medyczna'] },
  { title: 'Firma', subtitle: 'Majątek, OC i pracownicy', image: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85', points: ['OC działalności i zawodowe', 'Mienie i sprzęt firmy', 'Floty i ubezpieczenia grupowe'] },
  { title: 'Rolnictwo', subtitle: 'Gospodarstwo, uprawy i maszyny', image: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1400&q=85', points: ['OC rolnika', 'Budynki i maszyny', 'Uprawy i zwierzęta'] },
  { title: 'Podróże', subtitle: 'Leczenie, bagaż i ratownictwo', image: 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=1400&q=85', points: ['Koszty leczenia', 'Ratownictwo i Assistance', 'Sport i choroby przewlekłe'] },
];

const reviews = [
  ['Marcin Gąsiorek', 'Korzystam niezmiennie od dobrych kilku lat. Zawsze szybka i fachowa obsługa, jeszcze nigdy się nie zawiodłem.'],
  ['Magdalena Gumienna', 'Współpracujemy od kilku lat i zawsze wszystko jest sprawnie załatwione. Otrzymuję jasne podpowiedzi i dobre rozwiązania.'],
  ['Katarzyna Bączkiewicz', 'Ogromna wiedza, zaangażowanie i profesjonalizm. Polisa została idealnie dopasowana do moich potrzeb.'],
];

const faqs = [
  ['Czy wycena jest bezpłatna?', 'Tak. Porównanie wariantów i rozmowa z doradcą nie zobowiązują do zakupu polisy.'],
  ['Czy polisę można zawrzeć zdalnie?', 'Wiele rodzajów ubezpieczeń możemy przygotować telefonicznie lub online. Zakres zależy od produktu i wymaganych dokumentów.'],
  ['Czy pomagacie po wystąpieniu szkody?', 'Tak. Pomagamy uporządkować pierwsze kroki, wskazać właściwy kanał zgłoszenia i przygotować potrzebne informacje.'],
  ['Czy zawsze wybieracie najtańszą ofertę?', 'Nie automatycznie. Pokazujemy różnice w cenie i zakresie, aby klient świadomie wybrał właściwy wariant.'],
];

const statementLines = [
  {
    label: 'Rozpoznajemy potrzeby',
    text: 'Nie sprzedajemy jednej polisy.',
  },
  {
    label: 'Porównujemy możliwości',
    text: 'Porównujemy dostępne warianty i tłumaczymy najważniejsze różnice.',
  },
  {
    label: 'Zostajemy po zakupie',
    text: 'Pomagamy wybrać ochronę, która ma sens także wtedy, gdy wydarzy się szkoda.',
  },
];
---
<Layout title="Ubezpieczenia Zimmermann Kalisz i Krotoszyn | Porównanie ofert" description="Rodzinna multiagencja ubezpieczeniowa. Porównujemy oferty ponad 40 towarzystw i pomagamy także po zakupie polisy.">
  <div class="topbar"><div class="shell"><span>Kalisz · Krotoszyn · obsługa stacjonarna i zdalna</span><a href="#szkoda">Potrzebujesz pomocy przy szkodzie?</a></div></div>
  <header class="header" data-header>
    <div class="progress" data-progress></div>
    <div class="shell header__inner">
      <a class="brand" href="#start"><img src="/logo.jpg" alt=""/><span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span></a>
      <nav><a href="#oferta">Oferta</a><a href="#proces">Jak pracujemy</a><a href="#opinie">Opinie</a><a href="#kontakt">Kontakt</a></nav>
      <div class="header__actions"><a class="phone" href="tel:+48789315400">789 315 400</a><a class="btn btn--red magnetic" href="#kontakt">Porównaj oferty</a><button class="menu" data-menu aria-label="Menu"><span></span><span></span></button></div>
    </div>
    <div class="mobile-nav" data-mobile-nav><a href="#oferta">Oferta</a><a href="#proces">Jak pracujemy</a><a href="#szkoda">Pomoc przy szkodzie</a><a href="#opinie">Opinie</a><a href="#kontakt">Kontakt</a></div>
  </header>

  <main id="start">
    <section class="hero">
      <div class="hero__grid"></div>
      <div class="shell hero__inner">
        <div class="hero__copy">
          <div class="badge"><i></i> Rodzinna multiagencja od 2002 roku</div>
          <h1>Porównujemy wiele ofert. <em>Ty wybierasz spokojnie.</em></h1>
          <p>Doradzamy, wyjaśniamy różnice i pomagamy również wtedy, gdy pojawi się szkoda. Stacjonarnie w Kaliszu i Krotoszynie lub całkowicie zdalnie.</p>
          <div class="hero__actions"><a class="btn btn--red btn--large magnetic" href="#kontakt">Porównaj oferty</a><a class="btn btn--ghost btn--large" href="tel:+48789315400">Zadzwoń do doradcy ↗</a></div>
          <div class="proof"><div><strong>40+</strong><span>towarzystw</span></div><div><strong>24 lata</strong><span>doświadczenia</span></div><div><strong>5.0</strong><span>ocena klientów</span></div></div>
        </div>
        <div class="hero__visual">
          <div class="halo"></div><div class="hero__photo"><img src="/hero-family.png" alt="Rodzina pod czerwonym parasolem"/></div>
          <div class="float float--top"><small>Osobisty doradca</small><strong>przed i po zakupie</strong></div>
          <div class="float float--bottom"><small>Wiele wariantów</small><strong>jedna spokojna decyzja</strong></div>
        </div>
      </div>
    </section>

    <section class="logos"><div class="logos__track">{['PZU','WARTA','ERGO HESTIA','ALLIANZ','GENERALI','COMPENSA','UNIQA','SIGNAL IDUNA','WIENER','LINK4','PZU','WARTA','ERGO HESTIA','ALLIANZ','GENERALI','COMPENSA','UNIQA','SIGNAL IDUNA','WIENER','LINK4'].map((name)=><span>{name}</span>)}</div></section>

    <section class="statement" data-statement>
      <div class="statement__sticky">
        <div class="statement__glow" aria-hidden="true"></div>
        <div class="shell statement__layout">
          <aside class="statement__rail">
            <span class="eyebrow eyebrow--light">Nasza rola</span>
            <div class="statement__index" aria-hidden="true">
              <strong data-statement-current>01</strong>
              <i></i>
              <span>03</span>
            </div>
            <div class="statement__phases">
              {statementLines.map((line, index) => (
                <span class:list={['statement__phase', { active: index === 0 }]} data-statement-phase>
                  {line.label}
                </span>
              ))}
            </div>
          </aside>

          <div class="statement__content">
            <p aria-label={statementLines.map((line) => line.text).join(' ')}>
              {statementLines.map((line) => (
                <span class="statement__line" data-statement-line>
                  {line.text.split(' ').map((word) => (
                    <span class="statement__word" data-statement-word>{word}&nbsp;</span>
                  ))}
                </span>
              ))}
            </p>

            <footer class="statement__footer">
              <div class="statement__progress" aria-hidden="true">
                <i data-statement-progress></i>
              </div>
              <small>Najpierw potrzeby. Potem porównanie. Na końcu świadoma decyzja.</small>
            </footer>
          </div>
        </div>
      </div>
    </section>

    <section class="section explorer" id="oferta">
      <div class="shell"><div class="heading split"><div><span class="eyebrow reveal">Czego chcesz chronić?</span><h2 class="reveal">Zacznij od potrzeby, nie od nazwy produktu.</h2></div><p class="reveal">Wskaż obszar, a pokażemy najważniejsze elementy, o które warto zapytać przed wyborem polisy.</p></div>
        <div class="explorer__layout">
          <div class="explorer__nav">{services.map((service,index)=><button class:list={['service-tab',{'active':index===0}]} data-service={index}><span>{String(index+1).padStart(2,'0')}</span><strong>{service.title}</strong><i>↗</i></button>)}</div>
          <article class="service-panel" data-service-panel><div class="service-panel__image"><img src={services[0].image} alt={services[0].title} data-service-image/></div><div class="service-panel__copy"><span class="eyebrow" data-service-subtitle>{services[0].subtitle}</span><h3 data-service-title>{services[0].title}</h3><p>Porównujemy składkę, zakres, limity i ważne wyłączenia. Doradca tłumaczy różnice w prosty sposób.</p><ul data-service-points>{services[0].points.map(point=><li>{point}</li>)}</ul><a href="#kontakt" class="link">Poproś o porównanie →</a></div></article>
        </div>
      </div>
      <script type="application/json" data-services set:html={JSON.stringify(services)}></script>
    </section>

    <section class="process" id="proces">
      <div class="shell process__inner"><div class="process__intro"><span class="eyebrow eyebrow--light">Jak pracujemy</span><h2>Od pierwszej rozmowy do ochrony — bez zbędnych formalności.</h2><p>Każdy etap ma jeden cel: ułatwić wybór i ograniczyć ryzyko, że ważny szczegół zostanie pominięty.</p><a href="#kontakt" class="btn btn--light magnetic">Rozpocznij porównanie</a></div>
        <div class="steps"><div class="steps__line"><i></i></div>{[['Rozmowa bez formularzowej ściany','Pytamy o to, co faktycznie chcesz zabezpieczyć i czego oczekujesz od polisy.'],['Porównanie wariantów','Sprawdzamy nie tylko cenę, ale także zakres, limity, wyłączenia i obsługę szkody.'],['Jasne wyjaśnienie różnic','Dostajesz konkretne rekomendacje bez branżowego żargonu i presji.'],['Wsparcie po zakupie','W razie szkody pomagamy uporządkować kolejne kroki.']].map(([title,text],i)=><article class="step"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </div>
    </section>

    <section class="section claims" id="szkoda"><div class="shell claims__inner"><div class="claims__visual reveal-card"><div class="alert">!</div><span class="note note--1">Zabezpiecz miejsce zdarzenia</span><span class="note note--2">Zbierz zdjęcia i dokumenty</span><span class="note note--3">Skontaktuj się z doradcą</span></div><div><span class="eyebrow reveal">Polisa to dopiero początek</span><h2 class="reveal">Jesteśmy również wtedy, gdy wydarzy się szkoda.</h2><p class="reveal">Pomagamy uporządkować pierwsze kroki, wskazać właściwy kanał zgłoszenia i przygotować potrzebne informacje. Nie zostajesz sam z numerem infolinii.</p><div class="claims__actions reveal"><a class="btn btn--dark magnetic" href="tel:+48789315400">Zadzwoń po pomoc</a><a class="link" href="#kontakt">Przejdź do kontaktu →</a></div></div></div></section>

    <section class="stats"><div class="shell stats__grid"><div><strong data-counter="40">0</strong><span>towarzystw w ofercie</span></div><div><strong data-counter="24">0</strong><span>lata doświadczenia</span></div><div><strong data-counter="2">0</strong><span>lokalne biura</span></div><div><strong>5.0</strong><span>średnia ocen</span></div></div></section>

    <section class="section reviews" id="opinie"><div class="shell"><div class="heading split"><div><span class="eyebrow reveal">Opinie klientów</span><h2 class="reveal">Zaufanie budowane przez lata, nie przez hasła.</h2></div><div class="rating reveal"><strong>5.0</strong><span>★★★★★</span><small>opinie Google</small></div></div><div class="reviews__grid">{reviews.map(([name,text],i)=><article class:list={['review reveal-card',{'review--dark':i===0}]}><b>“</b><p>{text}</p><footer><i>{name.charAt(0)}</i><span><strong>{name}</strong><small>Opinia z Google</small></span></footer></article>)}</div></div></section>

    <section class="section locations"><div class="shell locations__inner"><div><span class="eyebrow reveal">Dwa lokalne biura</span><h2 class="reveal">Wybierz miejsce, które jest bliżej Ciebie.</h2><p class="reveal">Możesz przyjść do biura, zadzwonić lub załatwić wiele spraw zdalnie.</p><div class="location-tabs"><button class="active" data-location="kalisz">Kalisz</button><button data-location="krotoszyn">Krotoszyn</button></div></div><div class="location-card active" data-location-card="kalisz"><small>Biuro Kalisz</small><h3>ul. Konopnickiej 3-5, lok. 10</h3><p>62-800 Kalisz</p><a class="btn btn--red" href="tel:+48789315400">789 315 400</a></div><div class="location-card" data-location-card="krotoszyn"><small>Biuro Krotoszyn</small><h3>ul. Piastowska 30</h3><p>63-700 Krotoszyn</p><a class="btn btn--red" href="tel:+48502252048">502 252 048</a></div></div></section>

    <section class="section faq"><div class="shell faq__inner"><div class="faq__intro"><span class="eyebrow reveal">Najczęstsze pytania</span><h2 class="reveal">Najpierw odpowiedzi. Potem decyzja.</h2><p class="reveal">Nie musisz znać branżowych pojęć. Od tego jest doradca.</p></div><div class="faq__list">{faqs.map(([q,a],i)=><article class="faq-item reveal-card"><button data-faq><span>{String(i+1).padStart(2,'0')}</span><strong>{q}</strong><i>+</i></button><div><p>{a}</p></div></article>)}</div></div></section>

    <section class="contact" id="kontakt"><div class="shell contact__inner"><div><span class="eyebrow eyebrow--light reveal">Bezpłatne porównanie</span><h2 class="reveal">Zacznij od krótkiej informacji. Resztę ustalimy podczas rozmowy.</h2><p class="reveal">Wybierz kategorię i podaj telefon. Na urządzeniu mobilnym przygotujemy wiadomość SMS do biura.</p><ul class="reveal"><li>Bez zobowiązania</li><li>Bez zbędnych danych</li><li>Lokalny doradca</li></ul></div><div class="wizard reveal-card" data-wizard><div data-step="1"><small>Krok 1 z 2</small><h3>Czego dotyczy ubezpieczenie?</h3><div class="wizard__types">{services.map(service=><button type="button" data-type={service.title}>{service.title}<span>→</span></button>)}</div></div><div data-step="2" hidden><button class="back" type="button" data-back>← Wróć</button><small>Krok 2 z 2</small><h3>Jak możemy się skontaktować?</h3><form><input type="hidden" name="type"/><label>Imię<input name="name" required placeholder="Jan"/></label><label>Telefon<input name="phone" type="tel" required placeholder="500 600 700"/></label><label>Dodatkowe informacje<textarea name="message" rows="3" placeholder="Np. data końca polisy"></textarea></label><label class="consent"><input type="checkbox" required/><span>Zgadzam się na kontakt w sprawie wyceny.</span></label><button class="btn btn--red full" type="submit">Przygotuj wiadomość</button></form><div class="status" data-status hidden><strong>Wiadomość została przygotowana.</strong><span>Zadzwoń pod 789 315 400 lub wyślij przygotowany SMS.</span></div></div></div></div></section>
  </main>

  <footer class="footer"><div class="footer__word">ZIMMERMANN</div><div class="shell footer__grid"><div><a class="brand brand--footer" href="#start"><img src="/logo.jpg" alt=""/><span><strong>Zimmermann</strong><small>Ubezpieczenia</small></span></a><p>Rodzinna multiagencja ubezpieczeniowa w Kaliszu i Krotoszynie.</p></div><div><h3>Oferta</h3><a href="#oferta">Samochód</a><a href="#oferta">Dom i mieszkanie</a><a href="#oferta">Życie i zdrowie</a><a href="#oferta">Firma i rolnictwo</a></div><div><h3>Kontakt</h3><a href="tel:+48789315400">Kalisz: 789 315 400</a><a href="tel:+48502252048">Rafał: 502 252 048</a><a href="tel:+48506092200">Igor: 506 092 200</a></div></div><div class="shell footer__bottom"><span>© 2026 Ubezpieczenia Zimmermann</span><span>Partner Unilink S.A.</span></div></footer>
  <div class="mobile-bar"><a href="tel:+48789315400"><small>Telefon</small><strong>789 315 400</strong></a><a href="#kontakt">Wycena</a></div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"></script>
  <script is:inline>
    const init = () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menu = document.querySelector('[data-menu]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      menu?.addEventListener('click',()=>mobileNav?.classList.toggle('open'));
      mobileNav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>mobileNav.classList.remove('open')));
      const progress = document.querySelector('[data-progress]');
      addEventListener('scroll',()=>{const m=document.documentElement.scrollHeight-innerHeight; if(progress) progress.style.transform=`scaleX(${m?scrollY/m:0})`},{passive:true});
      document.querySelectorAll('[data-faq]').forEach(btn=>btn.addEventListener('click',()=>btn.closest('.faq-item')?.classList.toggle('open')));
      document.querySelectorAll('[data-location]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-location]').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('[data-location-card]').forEach(x=>x.classList.toggle('active',x.getAttribute('data-location-card')===btn.getAttribute('data-location')))}));
      const data = JSON.parse(document.querySelector('[data-services]')?.textContent||'[]');
      document.querySelectorAll('[data-service]').forEach(btn=>btn.addEventListener('click',()=>{const s=data[Number(btn.getAttribute('data-service'))];document.querySelectorAll('[data-service]').forEach(x=>x.classList.toggle('active',x===btn));const panel=document.querySelector('[data-service-panel]');const swap=()=>{panel.querySelector('[data-service-image]').src=s.image;panel.querySelector('[data-service-title]').textContent=s.title;panel.querySelector('[data-service-subtitle]').textContent=s.subtitle;panel.querySelector('[data-service-points]').innerHTML=s.points.map(p=>`<li>${p}</li>`).join('')}; if(window.gsap&&!reduce) gsap.to(panel,{opacity:0,y:10,duration:.2,onComplete:()=>{swap();gsap.to(panel,{opacity:1,y:0,duration:.4})}}); else swap()}));
      const wizard=document.querySelector('[data-wizard]'); if(wizard){wizard.querySelectorAll('[data-type]').forEach(btn=>btn.addEventListener('click',()=>{wizard.querySelector('[name=type]').value=btn.getAttribute('data-type');wizard.querySelector('[data-step="1"]').hidden=true;wizard.querySelector('[data-step="2"]').hidden=false}));wizard.querySelector('[data-back]')?.addEventListener('click',()=>{wizard.querySelector('[data-step="2"]').hidden=true;wizard.querySelector('[data-step="1"]').hidden=false});wizard.querySelector('form')?.addEventListener('submit',e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const msg=`Dzień dobry, proszę o kontakt. Ubezpieczenie: ${fd.get('type')}. Imię: ${fd.get('name')}. Telefon: ${fd.get('phone')}. Informacje: ${fd.get('message')||'brak'}.`; if(/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) location.href=`sms:+48789315400?body=${encodeURIComponent(msg)}`; else {navigator.clipboard?.writeText(msg);wizard.querySelector('[data-status]').hidden=false}})}
      if(reduce||!window.gsap||!window.ScrollTrigger)return; gsap.registerPlugin(ScrollTrigger);
      gsap.from('.hero__copy>*',{opacity:0,y:35,duration:.85,stagger:.08,ease:'power3.out'});
      gsap.from('.hero__visual',{opacity:0,scale:.94,duration:1.1,ease:'power3.out'});
      gsap.to('.hero__photo img',{yPercent:8,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
      gsap.utils.toArray('.reveal').forEach(el=>gsap.from(el,{opacity:0,y:28,duration:.7,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%',once:true}}));
      gsap.utils.toArray('.reveal-card').forEach(el=>gsap.from(el,{opacity:0,y:36,duration:.65,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 90%',once:true}}));

      if(innerWidth>850){
        const statement = document.querySelector('[data-statement]');
        const statementWords = gsap.utils.toArray('[data-statement-word]');
        const statementLines = gsap.utils.toArray('[data-statement-line]');
        const statementPhases = gsap.utils.toArray('[data-statement-phase]');
        const statementProgress = document.querySelector('[data-statement-progress]');
        const statementCurrent = document.querySelector('[data-statement-current]');
        const statementGlow = document.querySelector('.statement__glow');

        gsap.set(statementWords,{opacity:.12,y:18,filter:'blur(5px)'});
        gsap.set(statementLines,{opacity:.72});
        gsap.set(statementProgress,{scaleX:0,transformOrigin:'left center'});
        gsap.set(statementGlow,{opacity:.2,xPercent:-18});

        const setStatementPhase = (phaseIndex) => {
          statementPhases.forEach((phase,index)=>phase.classList.toggle('active',index===phaseIndex));
          statementLines.forEach((line,index)=>line.classList.toggle('active',index<=phaseIndex));
          if(statementCurrent) statementCurrent.textContent=String(phaseIndex+1).padStart(2,'0');
        };

        const statementTimeline = gsap.timeline({
          scrollTrigger:{
            trigger:statement,
            start:'top top+=82',
            end:'bottom bottom',
            scrub:.65,
            invalidateOnRefresh:true,
            onUpdate:(self)=>{
              const phaseIndex=Math.min(statementPhases.length-1,Math.floor(self.progress*statementPhases.length));
              setStatementPhase(phaseIndex);
            }
          }
        });

        statementTimeline
          .to(statementWords,{opacity:1,y:0,filter:'blur(0px)',duration:1,stagger:{each:.035},ease:'none'},0)
          .to(statementProgress,{scaleX:1,duration:1,ease:'none'},0)
          .to(statementGlow,{opacity:.7,xPercent:18,duration:1,ease:'none'},0)
          .fromTo('.statement__footer small',{opacity:.35,y:14},{opacity:1,y:0,duration:.2,ease:'none'},.78);
      }

      document.querySelectorAll('[data-counter]').forEach(el=>{const obj={v:0};gsap.to(obj,{v:Number(el.dataset.counter),duration:1.5,scrollTrigger:{trigger:el,start:'top 88%',once:true},onUpdate:()=>el.textContent=Math.round(obj.v)+(Number(el.dataset.counter)===40?'+':'')})});
      document.querySelectorAll('.magnetic').forEach(el=>{el.addEventListener('mousemove',e=>{const r=el.getBoundingClientRect();gsap.to(el,{x:(e.clientX-r.left-r.width/2)*.12,y:(e.clientY-r.top-r.height/2)*.12,duration:.2})});el.addEventListener('mouseleave',()=>gsap.to(el,{x:0,y:0,duration:.5,ease:'elastic.out(1,.4)'}))});
    }; document.addEventListener('DOMContentLoaded',init,{once:true});
  </script>
</Layout>
