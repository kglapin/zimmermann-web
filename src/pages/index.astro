---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import InsuranceExplorer from '../components/InsuranceExplorer.astro';
import ProcessAndClaims from '../components/ProcessAndClaims.astro';
import Locations from '../components/Locations.astro';
import ReviewsAndFaq from '../components/ReviewsAndFaq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Ubezpieczenia Zimmermann | Kalisz i Krotoszyn"
  description="Rodzinna multiagencja ubezpieczeniowa w Kaliszu i Krotoszynie. Porównujemy oferty wielu towarzystw i pomagamy również po zakupie polisy."
>
  <Header />
  <main id="start">
    <Hero />
    <Statement />
    <InsuranceExplorer />
    <ProcessAndClaims />
    <Locations />
    <ReviewsAndFaq />
    <Contact />
  </main>
  <Footer />
</Layout>
